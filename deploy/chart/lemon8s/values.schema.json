{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "string"
    },
    "backend": {
      "enum": ["auto", "vulkan", "rocm", "cuda", "cpu"]
    },
    "settings": {
      "type": ["object", "null"]
    },
    "devices": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "integer"
      }
    },
    "deviceGroups": {
      "type": ["array", "null"],
      "items": {
        "type": "integer"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer"
        }
      }
    },
    "apiKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": ["object", "null"]
    },
    "nodeSelector": {
      "type": ["object", "null"]
    },
    "tolerations": {
      "type": ["array", "null"]
    },
    "affinity": {
      "type": ["object", "null"]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string"
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
