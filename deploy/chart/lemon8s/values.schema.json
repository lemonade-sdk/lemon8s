{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "string"
    },
    "backend": {
      "enum": ["auto", "vulkan", "rocm", "cuda", "cpu"]
    },
    "devices": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "integer"
      }
    },
    "deviceGroups": {
      "type": ["array", "null"],
      "items": {
        "type": "integer"
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string"
        },
        "className": {
          "type": "string"
        }
      }
    }
  }
}
